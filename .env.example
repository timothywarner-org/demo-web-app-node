# Globomantics Robotics API - Environment Configuration
# Copy this file to .env and configure for your environment

# ======================
# Server Configuration
# ======================
NODE_ENV=development
PORT=3000

# ======================
# CORS Configuration
# ======================
# Use '*' for all origins in development, specify exact origins in production
CORS_ORIGIN=*

# ======================
# Feature Flags
# ======================
FEATURE_ADVANCED_DIAGNOSTICS=true
FEATURE_AI_INTEGRATION=false
